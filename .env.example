# Autonest Self Drive Cars Environment Configuration
PORT=5000
JWT_SECRET=autonest_secret_key_2026_chennai_production
MONGODB_URI=mongodb://localhost:27017/autonest

# Google OAuth 2.0 Credentials
# Configure in Google Cloud Console (https://console.cloud.google.com):
# 1. Create Credentials -> OAuth 2.0 Client IDs -> Web Application
# 2. Add Authorized JavaScript Origin: http://localhost:5173
# 3. Add Authorized Redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URL (for OAuth redirects and password reset links)
FRONTEND_URL=http://localhost:5173
